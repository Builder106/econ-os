# EconOS Environment Configuration
# Copy this file to .env or .env.local for local development.

# ==============================================================================
# Frontend (Vercel Build / Dashboard)
# ==============================================================================
# Remote WebSocket URL for the kernel.
# In production on Vercel: set to your public WSS endpoint (e.g. wss://<host>.<tailnet>.ts.net/ws).
# For local dev: leave empty/unset to fall back to same-origin (ws://<host>/ws).
ECONOS_KERNEL_WS_URL=

# ==============================================================================
# Backend / Simulation Kernel (FastAPI / Docker / VM)
# ==============================================================================
# Secret string required to issue admin shell commands (e.g. 'sudo <token>').
# Leave empty to run with admin privileges universally disabled.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# CORS — comma-separated list of allowed frontend dashboard origins.
# Use '*' during initial testing; set to your deployed Vercel domain in production.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://econ-os.vercel.app

# Optional regex to permit Vercel preview branch deployments to connect.
ALLOWED_ORIGIN_REGEX=^https://econ-os-git-[a-z0-9-]+-sankofa-forge\.vercel\.app$

# ==============================================================================
# Kernel Tuning & Checkpoint Paths (Optional)
# ==============================================================================
# Milliseconds between simulation ticks (default: 500)
TICK_MS=500

# Maximum environment cycles before resetting simulation (default: 5000)
MAX_CYCLES=5000

# Trained PPO model checkpoints
CONSUMER_MODEL=models/consumer_policy.zip
PRODUCER_MODEL=models/producer_policy.zip

# ==============================================================================
# E2E & Live Testing (Optional)
# ==============================================================================
# Target URL for live smoke tests (default: https://econ-os.vercel.app)
# LIVE_BASE_URL=https://econ-os.vercel.app

# Set to 1 to record Playwright browser sessions for video demos
# RECORD_DEMOS=1
